<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pour rejouer le cas décisif : l'offre affichée dans une fenêtre
         flottante par-dessus l'écran d'accueil, focus resté au-dessous. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/nom_app"
        android:supportsRtl="false"
        android:theme="@style/Theme.Simulateur">

        <!-- exported : les essais instrumentés la démarrent depuis l'extérieur. -->
        <activity
            android:name=".ActivitePrincipale"
            android:exported="true"
            android:label="@string/nom_app">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

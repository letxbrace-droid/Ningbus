<?xml version="1.0" encoding="utf-8"?>
<!--
    Thème sombre en toutes circonstances, et non « selon le réglage du
    téléphone ».

    L'application se consulte au volant, souvent de nuit, et presque toujours
    juste avant ou juste après une bulle qui est sombre elle aussi. Basculer en
    blanc au petit matin ferait pire que ne rien faire : l'œil met plusieurs
    secondes à se réadapter, et ces secondes-là sont celles du compte à
    rebours.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Arbitre" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primaire</item>
        <item name="colorOnPrimary">@color/nuit</item>
        <item name="colorSecondary">@color/primaire</item>
        <item name="android:colorBackground">@color/nuit</item>
        <item name="colorSurface">@color/nuit_carte</item>
        <item name="colorSurfaceVariant">@color/nuit_relief</item>
        <item name="android:textColorPrimary">@color/bulle_texte</item>
        <item name="android:textColorSecondary">@color/bulle_texte_doux</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/nuit</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/nuit</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <!--
        L'échelle typographique de la maquette : cinq niveaux, pas six.

        Chaque niveau a un emploi et un seul. H1 pour le titre d'un écran, H2
        pour un titre de section, H3 pour une valeur qui doit se lire sans
        être cherchée, T1 pour le texte courant, T2 pour ce qui n'est lu qu'en
        cas de doute. Un sixième niveau se serait glissé entre deux autres, et
        personne n'aurait plus su lequel choisir.
    -->
    <!-- La base : les cinq niveaux en héritent par leur nom pointé, ce qui
         évite de répéter la couleur d'encre cinq fois. -->
    <style name="Texte">
        <item name="android:textColor">@color/bulle_texte</item>
    </style>

    <style name="Texte.H1">
        <item name="android:textSize">28sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texte.H2">
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texte.H3">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texte.T1">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Texte.T2">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bulle_texte_doux</item>
    </style>

    <!-- Les titres de rubrique des réglages : assez d'air au-dessus pour que
         l'œil sache qu'il change de sujet sans avoir à lire. -->
    <style name="Rubrique" parent="Texte.H2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/espace_m</item>
    </style>

    <!--
        L'interrupteur, en Material 3.

        Le modèle d'AppCompat — un petit rail et une pastille — se lit mal au
        volant et se confond d'un état à l'autre. Celui-ci a une piste pleine,
        un pouce qui grossit quand il s'allume, et une animation qui dit dans
        quel sens on vient de le pousser. Il coûte trois listes de couleurs, et
        c'est la différence entre « je crois que c'est activé » et « c'est
        activé ».
    -->
    <style name="Interrupteur" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/bulle_texte</item>
        <item name="thumbTint">@color/interrupteur_pouce</item>
        <item name="trackTint">@color/interrupteur_piste</item>
        <item name="trackDecorationTint">@color/interrupteur_contour</item>
    </style>

    <!-- Le texte d'aide qui suit un réglage : présent, jamais bavard. -->
    <style name="Aide" parent="Texte.T2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingBottom">@dimen/espace_xs</item>
    </style>

    <!-- Une carte : la surface sur laquelle vit tout contenu. -->
    <style name="Carte">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/fond_carte</item>
        <item name="android:padding">@dimen/espace_s</item>
        <item name="android:layout_marginTop">@dimen/espace_xs</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        La palette de la maquette 2.0.

        Elle remplace les néons de la version précédente — #00E676, #FFAB00,
        #FF1744 sur noir absolu — et le changement mérite d'être justifié,
        parce que ces néons avaient été choisis pour une raison précise : le
        plein soleil derrière un pare-brise, et la conduite de nuit où l'œil
        est adapté au noir.

        Les nouvelles teintes restent au-dessus de 6:1 sur la surface la plus
        claire, ce qui les garde lisibles dans les deux cas ; elles sont
        simplement moins criardes, et surtout elles se distinguent mieux entre
        elles qu'un vert et un ambre poussés tous les deux à saturation
        maximale. Au volant, distinguer le verdict compte plus que le voir de
        loin — on ne lit pas cette bulle à deux mètres.
    -->

    <!-- Accent : boutons, onglet actif, valeurs mises en avant. -->
    <color name="primaire">#FF00B4FF</color>
    <!-- L'autre bout du dégradé de l'action principale. Un dégradé sur un
         seul bouton par écran : deux, et il n'y a plus d'action principale. -->
    <color name="bleu_clair">#FF5ED0FF</color>

    <!-- Les trois couleurs du verdict. -->
    <color name="vert">#FF22C55E</color>
    <color name="ambre">#FFF59E0B</color>
    <color name="rouge">#FFEF4444</color>
    <color name="gris">#FF94A3B8</color>

    <!--
        Fond quasi noir plutôt que noir absolu.

        Sur dalle AMOLED, #06080D allume les pixels très faiblement au lieu de
        les éteindre — le coût en batterie est négligeable, et le gain est un
        fond qui ne « creuse » pas sous les cartes : à noir absolu, la bordure
        d'une surface sombre devient la seule chose visible, et l'écran se lit
        comme une grille de traits.
    -->
    <color name="nuit">#FF06080D</color>
    <!-- Surface des cartes. -->
    <color name="nuit_carte">#FF111827</color>
    <!-- Surface élevée : champs de saisie, puces, onglet actif. -->
    <color name="nuit_relief">#FF1B2433</color>

    <!-- La bulle garde ses propres couleurs : elle se pose par-dessus
         n'importe quelle application et ne peut hériter d'aucun thème. -->
    <color name="bulle_fond">#F2111827</color>
    <color name="bulle_texte">#FFF8FAFC</color>
    <color name="bulle_texte_doux">#FF94A3B8</color>

    <color name="fond_icone">#FF111827</color>
</resources>

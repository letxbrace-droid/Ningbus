<?xml version="1.0" encoding="utf-8"?>
<!--
    La bulle d'arbitrage, en cinq niveaux de lecture.

    Le chauffeur doit pouvoir s'arrêter au premier et avoir déjà décidé :

      1. la décision      PRENDS / LIMITE / LAISSE
      2. l'argent         28,4 €/h
      3. les contraintes  12,6 km · 31 min
      4. l'explication    course 8,4 km · approche 4,2 km · retour 2,9 km
      5. le diagnostic    lecture, score, confiance

    Tout ce qui suit le niveau 2 est là pour justifier après coup, jamais pour
    décider. D'où le mode réduit : une pilule qui ne garde que les deux
    premiers, et qu'un appui développe.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/carte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fond_bulle"
        android:elevation="8dp"
        android:orientation="vertical">

        <!-- ============ Mode réduit : décision + argent, rien d'autre ======= -->
        <LinearLayout
            android:id="@+id/pilule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <View
                android:id="@+id/pilule_point"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/fond_puce" />

            <!--
                Les deux chiffres, et non un seul.

                La bulle réduite n'a d'abord montré que l'euro/heure, puis que
                l'euro/kilomètre — et une carte relevée à Brétigny a montré
                que ni l'un ni l'autre ne suffit : « 1,02 €/km · LAISSE » est
                incompréhensible, parce que 1,02 €/km a l'air correct et que
                la course paie pourtant 19 €/h. Le mode réduit doit rester
                décidable ; s'il faut développer pour comprendre, il ne sert
                plus à rien.
            -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pilule_euro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pilule_heure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bulle_texte_doux"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/pilule_verdict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============ Mode développé ===================================== -->
        <LinearLayout
            android:id="@+id/detaille"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Niveau 1 : la décision. Teinte posée à l'exécution. -->
            <LinearLayout
                android:id="@+id/entete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fond_entete"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/verdict"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/latence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <!-- Niveau 2 : l'argent. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <!--
                        L'euro par kilomètre passe devant l'euro par heure, et
                        ce n'est pas un choix de mise en page.

                        Le second suppose une durée, souvent estimée par le
                        moteur quand la plateforme ne l'annonce pas ; le
                        premier ne suppose rien. Devant une offre qui laisse
                        douze secondes, le chiffre qui ne dépend d'aucune
                        hypothèse mérite la grande taille — et c'est celui que
                        tout le métier compare d'une plateforme à l'autre.
                    -->
                    <TextView
                        android:id="@+id/euro_km"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/euro_heure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/bulle_texte_doux"
                        android:textSize="16sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="6dp">

                    <ProgressBar
                        android:id="@+id/jauge"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:max="100"
                        android:progress="50" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@color/bulle_texte" />
                </FrameLayout>

                <TextView
                    android:id="@+id/objectif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textColor="@color/bulle_texte_doux"
                    android:textSize="11sp" />

                <!-- Le motif : pourquoi ce verdict, et pas un autre. -->
                <TextView
                    android:id="@+id/motif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Niveau 3 : les contraintes, d'un coup d'œil. -->
                <TextView
                    android:id="@+id/contraintes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/bulle_texte"
                    android:textSize="16sp" />

                <!-- Le coût de roulage, poste par poste. Un total de 3,30 €
                     se croit ou ne se croit pas ; trois lignes se vérifient. -->
                <TextView
                    android:id="@+id/couts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/bulle_texte_doux"
                    android:textSize="13sp" />

                <!-- Niveau 4 : les trois kilométrages, jamais additionnés. -->
                <TextView
                    android:id="@+id/km_course"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/bulle_texte_doux"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/km_approche"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bulle_texte_doux"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/km_retour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bulle_texte_doux"
                    android:textSize="14sp" />

                <!--
                    L'avertissement de zone morte.

                    Il n'apparaît que lorsqu'il contredit le verdict : une
                    dépose loin, dans un secteur qui ne redemande rien, se paie
                    le retour complet à vide. Le moteur ne sait pas quelles
                    zones sont mortes ; le chauffeur, si. On lui donne le
                    chiffre, pas la décision.
                -->
                <TextView
                    android:id="@+id/retour_plein"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/trafic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bulle_texte_doux"
                    android:textSize="14sp" />

                <!-- Niveau 5 : d'où vient ce qu'on vient de lire. -->
                <TextView
                    android:id="@+id/diagnostic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/alertes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ambre"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

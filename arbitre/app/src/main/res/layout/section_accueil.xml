<?xml version="1.0" encoding="utf-8"?>
<!--
    Accueil : le cockpit.

    Il répond à deux questions et à deux seulement — « est-ce que ça
    marche ? » et « qu'a-t-il dit de la dernière course ? ». Tout ce qui se
    règle est ailleurs : un écran d'accueil sur lequel on règle quelque chose
    n'est plus un écran d'accueil, c'est le début des réglages.

    Presque tout son contenu est bâti en Kotlin, parce qu'il dépend d'une
    couleur de verdict qui n'existe qu'à l'exécution. Le XML ne pose que les
    emplacements.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/espace_s"
        android:paddingTop="@dimen/espace_s"
        android:paddingEnd="@dimen/espace_s"
        android:paddingBottom="@dimen/espace_m">

        <!-- ============ L'en-tête ============ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/marque"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="@dimen/espace_xs"
                android:contentDescription="@string/nom_app"
                android:src="@drawable/ic_marque" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Texte.H1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nom_app" />

                <TextView
                    style="@style/Texte.T2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/baseline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/version_app"
                    style="@style/Texte.T2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fond_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/etiquette_ligne"
                    style="@style/Texte.T2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ L'état des services ============ -->

        <LinearLayout
            android:id="@+id/carte_etat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_s"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:padding="@dimen/espace_s" />

        <!-- ============ La dernière course ============ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_m"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icone_derniere"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/espace_xs"
                android:contentDescription="@string/derniere_course"
                android:src="@drawable/ic_horloge" />

            <TextView
                style="@style/Texte.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/derniere_course" />

            <TextView
                android:id="@+id/age_derniere"
                style="@style/Texte.T2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/carte_derniere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_xs"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:padding="@dimen/espace_s" />

        <TextView
            android:id="@+id/aucune_course"
            style="@style/Texte.T2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_xs"
            android:text="@string/journal_vide_resume"
            android:visibility="gone" />

        <!-- ============ L'action principale ============ -->

        <LinearLayout
            android:id="@+id/bouton_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_s"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/espace_s"
            android:paddingEnd="@dimen/espace_s">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/espace_xs"
                android:contentDescription="@string/tester"
                android:src="@drawable/ic_lecture"
                app:tint="@color/nuit" />

            <TextView
                style="@style/Texte.H3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tester"
                android:textColor="@color/nuit" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/tester"
                android:src="@drawable/ic_chevron"
                app:tint="@color/nuit" />
        </LinearLayout>

        <!-- ============ Ce que l'application promet ============ -->

        <LinearLayout
            android:id="@+id/conteneur_atouts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_s"
            android:orientation="horizontal" />
    </LinearLayout>
</ScrollView>

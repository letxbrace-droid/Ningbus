<?xml version="1.0" encoding="utf-8"?>
<!--
    Réglages, en quatre groupes : moteur d'arbitrage, détection, interface,
    diagnostic système.

    L'ordre suit la fréquence décroissante avec laquelle on y revient. Le
    barème se pense une fois et se retouche après une mauvaise soirée ; la
    détection ne se touche qu'en cas de panne ; le diagnostic ne se règle pas
    du tout, il se lit.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/espace_s"
        android:paddingTop="@dimen/espace_s"
        android:paddingEnd="@dimen/espace_s"
        android:paddingBottom="@dimen/espace_m">

        <TextView
            style="@style/Texte.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titre_reglages" />

        <!-- ================= 🎯 Moteur d'arbitrage ================= -->

        <TextView
            style="@style/Rubrique"
            android:text="@string/titre_rentabilite" />

        <TextView
            style="@style/Aide"
            android:text="@string/aide_bareme" />

        <LinearLayout
            android:id="@+id/conteneur_rentabilite"
            style="@style/Carte" />

        <TextView
            style="@style/Rubrique"
            android:text="@string/titre_course" />

        <TextView
            style="@style/Aide"
            android:text="@string/aide_course" />

        <LinearLayout
            android:id="@+id/conteneur_course"
            style="@style/Carte" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/prudence"
            style="@style/Interrupteur"
            android:text="@string/prudence_active" />

        <Button
            android:id="@+id/bouton_defaut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_s"
            android:text="@string/reinitialiser" />

        <!-- ================= 🔍 Détection ================= -->

        <TextView
            style="@style/Rubrique"
            android:text="@string/titre_detection" />

        <LinearLayout
            style="@style/Carte"
            android:animateLayoutChanges="true">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/actif"
                style="@style/Interrupteur"
                android:text="@string/arbitrage_actif" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/filtre_ecrans"
                style="@style/Interrupteur"
                android:text="@string/filtre_ecrans" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/ocr"
                style="@style/Interrupteur"
                android:text="@string/ocr_secours" />

            <TextView
                style="@style/Aide"
                android:text="@string/aide_ocr" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/veille"
                style="@style/Interrupteur"
                android:text="@string/veille" />

            <TextView
                style="@style/Aide"
                android:text="@string/aide_veille" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/decouverte"
                style="@style/Interrupteur"
                android:text="@string/decouverte_active" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/toutes_apps"
                style="@style/Interrupteur"
                android:text="@string/toutes_apps" />

            <TextView
                style="@style/Aide"
                android:text="@string/aide_toutes_apps" />
        </LinearLayout>

        <!-- Applications écoutées -->

        <TextView
            style="@style/Texte.H3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_s"
            android:text="@string/titre_apps" />

        <TextView
            style="@style/Aide"
            android:text="@string/aide_apps" />

        <LinearLayout
            android:id="@+id/conteneur_apps"
            android:animateLayoutChanges="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/champ_paquet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/indice_paquet"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:textSize="14sp" />

            <Button
                android:id="@+id/bouton_ajouter_paquet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ajouter" />
        </LinearLayout>

        <!-- ================= 🎨 Interface ================= -->

        <TextView
            style="@style/Rubrique"
            android:text="@string/titre_affichage" />

        <LinearLayout
            style="@style/Carte">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espace_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Texte.T1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/duree_bulle" />

                <EditText
                    android:id="@+id/champ_secondes"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:gravity="end"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:textSize="17sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/compact"
                style="@style/Interrupteur"
                android:text="@string/mode_compact" />

            <TextView
                style="@style/Aide"
                android:text="@string/aide_mode_compact" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/details_couts"
                style="@style/Interrupteur"
                android:text="@string/details_couts" />

            <TextView
                style="@style/Aide"
                android:text="@string/aide_details_couts" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/bouton_flottant"
                style="@style/Interrupteur"
                android:text="@string/bouton_flottant" />

            <TextView
                style="@style/Aide"
                android:text="@string/aide_bouton_flottant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/vibration"
                style="@style/Interrupteur"
                android:text="@string/vibration_active" />
        </LinearLayout>

        <!-- ================= 🔧 Diagnostic système ================= -->

        <TextView
            style="@style/Rubrique"
            android:text="@string/titre_diagnostic" />

        <TextView
            style="@style/Aide"
            android:text="@string/aide_diagnostic" />

        <!-- Une ligne par organe : une puce, un nom, un état. Les listes de
             texte se lisent mal d'un coup d'œil ; une puce rouge, non. -->
        <LinearLayout
            android:id="@+id/conteneur_sante"
            android:animateLayoutChanges="true"
            style="@style/Carte"
            android:padding="@dimen/espace_xs" />

        <TextView
            android:id="@+id/diagnostic"
            style="@style/Texte.T2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_xs" />

        <!-- Les trois permissions, et rien qui les remplace. -->

        <TextView
            style="@style/Texte.H3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espace_s"
            android:text="@string/titre_permissions" />

        <LinearLayout
            style="@style/Carte">

            <TextView
                style="@style/Texte.T1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permission_ecran" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espace_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/etat_ecran"
                    style="@style/Texte.H3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/bouton_ecran"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ouvrir_reglages" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Carte">

            <TextView
                style="@style/Texte.T1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permission_superposition" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espace_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/etat_superposition"
                    style="@style/Texte.H3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/bouton_superposition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ouvrir_reglages" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Carte">

            <TextView
                style="@style/Texte.T1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permission_notif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espace_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/etat_notif"
                    style="@style/Texte.H3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/bouton_notif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ouvrir_reglages" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

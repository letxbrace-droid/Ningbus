<?xml version="1.0" encoding="utf-8"?>
<!--
    La coque : un conteneur de sections, et une barre d'onglets.

    L'écran unique qui défilait sur trois mètres avait un défaut qu'aucun
    soin de mise en page ne corrigeait : pour voir l'état des services, il
    fallait passer devant le barème ; pour régler le barème, il fallait passer
    devant le simulateur. Quatre destinations qui ne se ressemblent pas
    méritent quatre adresses.

    Les sections sont incluses et non chargées à la demande : elles tiennent
    en mémoire sans effort, et basculer d'un onglet à l'autre doit être
    instantané — c'est la moitié de ce qui fait qu'une application paraît
    soignée.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nuit"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/conteneur_sections"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/section_accueil"
            layout="@layout/section_accueil" />

        <include
            android:id="@+id/section_courses"
            layout="@layout/section_courses" />

        <include
            android:id="@+id/section_simulateur"
            layout="@layout/section_simulateur" />

        <include
            android:id="@+id/section_reglages"
            layout="@layout/section_reglages" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1FFFFFFF" />

    <!-- Les quatre onglets sont construits en Kotlin : même code pour les
         quatre, et l'état actif se pose d'une boucle plutôt que de quatre
         blocs XML qu'il faudrait tenir en accord. -->
    <LinearLayout
        android:id="@+id/barre_onglets"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hauteur_onglets"
        android:background="@color/nuit_carte"
        android:orientation="horizontal" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Le pouce : blanc franc quand c'est allumé, gris éteint sinon. Le contraste
     entre les deux états doit se lire sans avoir à chercher la position. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="#FF9AA5B4" android:state_enabled="false" />
    <item android:color="#FFFFFFFF" android:state_checked="true" />
    <item android:color="@color/gris" />
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
    La pilule d'un indicateur : « Accessibilité · Actif », « Pickup court ·
    1,4 km », « €/km fort ».

    Le fond reste neutre et c'est le texte qui porte la couleur du sens. Une
    pilule pleine de vert à côté d'une pilule pleine d'ambre donnerait un
    écran de feux de signalisation où plus rien ne ressort — or ces chips
    s'affichent par trois ou par quatre.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nuit_relief" />
    <corners android:radius="@dimen/rayon_chip" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>

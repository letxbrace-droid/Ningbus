<?xml version="1.0" encoding="utf-8"?>
<!-- La surface de la maquette : #111827 sur fond #06080D, cernée d'un trait
     à peine visible. Assez pour séparer deux blocs, trop peu pour éclairer
     l'habitacle de nuit. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nuit_carte" />
    <corners android:radius="@dimen/rayon_carte" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>

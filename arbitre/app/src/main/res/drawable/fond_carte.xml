<?xml version="1.0" encoding="utf-8"?>
<!-- Carte de contenu sur fond noir : un gris à peine levé, cerné d'un trait
     discret. Assez pour séparer deux blocs, trop peu pour éclairer l'habitacle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nuit_carte" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
